{
  "manifestVersion": 5,
  "id": "com.aroha.premiere.extension",
  "name": "Aroha",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "24.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aroha.panel",
      "name": "Aroha",
      "main": "index.html",
      "minimumSize": {
        "width": 380,
        "height": 520
      },
      "maximumSize": {
        "width": 600,
        "height": 900
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 620
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/aroha.png",
      "scale": [1, 2],
      "theme": ["dark", "light", "all"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "allowCodeGenerationFromStrings": true
  }
}
