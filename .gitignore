# Large Binaries (Exceeds GitHub 100MB file limit)
# Run .\setup_binaries.ps1 to download them locally, or download the pre-built installer from Releases.
bin/win-x64/*.exe
bin/win-x64/*.zip
bin/win-x64/*.old
bin/win-x64/*.new
bin/win-x64/*.part
bin/win-x64/*.ytdl
!bin/win-x64/.gitkeep

# Inno Setup output build (distributables hosted on GitHub Releases)
dist/*.exe
dist/

# Scratch & temporary download test files
scratch/
*.part
*.ytdl
*.temp
aroha_raw_*

# Logs and runtime caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
Thumbs.db
[Dd]esktop.ini
.DS_Store
